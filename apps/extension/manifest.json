{
  "manifest_version": 3,
  "name": "LatentPay",
  "version": "0.3.0",
  "description": "Earn rewards while LLMs generate answers.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "css": ["inject.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
