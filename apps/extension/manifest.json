{
  "manifest_version": 3,
  "name": "LatentPay",
  "version": "0.1.0",
  "description": "Earn rewards while LLMs generate answers.",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["inject.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
